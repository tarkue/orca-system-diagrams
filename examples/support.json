      "label": "> 50000 RUB impact; согласование включено"
    },
    {
      "from": "threshold",
      "to": "execute",
      "label": "≤ 50000 RUB impact или без согласования"
    },
    {
      "from": "approval",
      "to": "execute",
      "label": "Одобрено"
    },
    {
      "from": "approval",
      "to": "decline",
      "label": "Отклонено"
    },
    {
      "from": "execute",
