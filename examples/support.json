          "key": true
        },
        {
          "name": "ticket_id",
          "type": "string",
          "key": false
        },
        {
          "name": "engineer",
          "type": "string",
          "key": false
        },
        {
          "name": "resolution",
          "type": "string",
          "key": false
        }
      ]
    }
  ],
  "entityRelations": [
    {
      "from": "entity0",
      "to": "entity1",
      "label": "содержит",
      "cardinality": "one-to-many"
    },
    {
      "from": "entity1",
      "to": "entity2",
      "label": "исполняется через",
      "cardinality": "one-to-many"
    }
  ],
  "states": [
