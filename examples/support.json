        {
          "name": "ticket_id",
          "type": "string",
          "key": true
        },
        {
          "name": "customer_id",
          "type": "string",
          "key": false
        },
        {
          "name": "impact",
          "type": "decimal",
          "key": false
        },
        {
          "name": "priority",
          "type": "string",
          "key": false
        },
        {
          "name": "sla_deadline",
